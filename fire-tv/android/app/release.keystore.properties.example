# Copy this file to `release.keystore.properties` (same directory) and
# fill in real values to build a properly signed release artifact.
#
# `release.keystore.properties` is gitignored — never commit it, and
# never commit the keystore file itself.
#
# These same four values can instead be supplied via environment
# variables (PIT_WALL_RELEASE_STORE_FILE, PIT_WALL_RELEASE_STORE_PASSWORD,
# PIT_WALL_RELEASE_KEY_ALIAS, PIT_WALL_RELEASE_KEY_PASSWORD) or as
# Gradle properties of the same names — useful for CI, where the values
# come from a secret store rather than a checked-out file.
#
# storeFile is resolved relative to fire-tv/android/app/.

storeFile=/absolute/path/to/pit-wall-copilot-release.jks
storePassword=REPLACE-WITH-REAL-STORE-PASSWORD
keyAlias=pit-wall-copilot-release
keyPassword=REPLACE-WITH-REAL-KEY-PASSWORD
