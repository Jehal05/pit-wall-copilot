<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Spec v1.1 repair 1 — Fire TV / Android TV requirements:

      * android.software.leanback (required) declares this as a TV app
        (Android TV / Fire TV) rather than a phone/tablet app that merely
        tolerates a TV.
      * android.hardware.touchscreen (NOT required) lets the app install
        and run on a Fire TV device/emulator that reports no touchscreen
        at all — omitting this uses-feature (or leaving it "required",
        the AndroidManifest default) is exactly the bug the spec calls
        out ("Do not depend on touch input" / repair 1's own text).
      * No RECORD_AUDIO permission and no microphone-button intent
        handling is declared anywhere in this manifest — the app never
        captures or overrides the Fire TV remote's microphone button
        (spec: "Do not capture or override the Fire TV microphone
        button").
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:banner="@drawable/tv_banner"
      android:allowBackup="false"
      android:usesCleartextTraffic="false"
      android:theme="@style/AppTheme"
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:banner="@drawable/tv_banner"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:screenOrientation="landscape"
        android:exported="true">
        <!--
          Spec v1.1 repair 1: "Add LEANBACK_LAUNCHER" — this is what makes
          the app appear on the Fire TV/Android TV home-screen launcher
          row at all; without it, ADB can install the APK but the Fire TV
          launcher never shows an icon for it. The ordinary MAIN/LAUNCHER
          filter is kept alongside it so the same activity is also
          reachable from a phone/tablet/emulator launcher during
          development.
        -->
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
