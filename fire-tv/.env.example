# Spec v1.1 repair 13: configurable API/WS base URL, no manual src/api/client.ts
# edits required.
#
# Copy this file to `.env` (git-ignored; never commit real values) and set
# API_BASE_URL to wherever the backend is reachable from your device:
#
#   - Android emulator: the emulator cannot reach "localhost" on the host
#     machine, so use the special emulator alias for the host loopback:
#       API_BASE_URL=http://10.0.2.2:8000
#   - Physical Android/Fire TV device on the same network as the backend:
#     use the backend machine's LAN IP:
#       API_BASE_URL=http://192.168.1.20:8000
#   - iOS simulator (host loopback is reachable directly):
#       API_BASE_URL=http://localhost:8000
#
# The WebSocket base URL is derived automatically from API_BASE_URL
# (http->ws, https->wss) in src/hooks/useRaceSocket.ts — there is no
# separate WS_BASE_URL to set.
#
# After changing `.env`, restart Metro (`npm start -- --reset-cache`) since
# react-native-dotenv inlines these values at bundle time, not at runtime.

API_BASE_URL=http://10.0.2.2:8000
