# Copy this file to backend/.env for local development. Do NOT commit .env.
# No value below is a real credential.

# "memory" (default, no AWS required) or "dynamodb"
STATE_REPOSITORY=memory

# Only used when STATE_REPOSITORY=dynamodb
DYNAMODB_TABLE_NAME=pit-wall-race-state
AWS_REGION=us-east-1
# Set this to point at DynamoDB Local for offline development, e.g.:
# DYNAMODB_ENDPOINT_URL=http://localhost:8000
DYNAMODB_ENDPOINT_URL=

# Path to the scenario file (defaults to scenarios/scenario-demo-01.json)
SCENARIO_PATH=

# Comma-separated list of allowed CORS origins for local Fire TV / React
# Native development. Never set this to "*" — list exact origins.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://10.0.2.2:8081,http://localhost:19006

# Shared-secret token required in the X-Demo-Access-Token header for
# mutating endpoints (start/pause/reset). Spec v1.1 repair 11: the backend
# ships with NO default value for this — leaving it unset means every
# mutating endpoint is refused (HTTP 503 auth_not_configured), fail-closed.
# For a real/shared deployment, generate a strong random value yourself
# (e.g. `openssl rand -base64 24`) and set it via your secret store, not
# this file. This line is a placeholder, not a working credential:
DEMO_ACCESS_TOKEN=

# For LOCAL DEVELOPMENT ONLY: set this to true to have the backend
# generate a fresh random token itself at startup and print it once to
# stderr (never persisted, never the same value twice). Leave this false
# (or unset) for any deployment other than your own machine.
LOCAL_DEMO_AUTH_MODE=false

# LLM_PROVIDER: "template" (default — deterministic, no AWS account
# required) or "bedrock" (real Anthropic-on-Bedrock model; requires AWS
# credentials with bedrock-runtime:InvokeModel and a valid model access
# grant — see backend/app/services/llm_client.py; NOT exercised against a
# real AWS account as part of this repository's own testing).
LLM_PROVIDER=template
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1
# Set this to point at a local Bedrock-compatible endpoint if you have one.
BEDROCK_ENDPOINT_URL=

# Path to the sporting-rules Knowledge Base folder (defaults to
# docs/sporting-rules relative to the repository root).
KNOWLEDGE_BASE_DIR=

# Path to the get_regulation fact corpus (spec v1.1 repair 8; defaults to
# docs/sporting-rules/regulations relative to the repository root). See
# that folder's own README.md for the fact file format.
REGULATIONS_DIR=

# Per-client-IP cap on GET .../explain calls per 60-second window (fixes
# the Gate 3 "no rate-limiting on /explain" limitation). Set to 0 or a
# negative number to disable rate-limiting entirely.
EXPLAIN_RATE_LIMIT_PER_MINUTE=30
